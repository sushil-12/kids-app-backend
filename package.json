{
  "name": "brightmind-backend",
  "version": "1.0.0",
  "description": "BrightMind Kids content API backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:packs": "tsx --env-file=.env prisma/seed.packs.ts",
    "db:backfill": "tsx --env-file=.env prisma/backfill.ts",
    "db:studio": "prisma studio",
    "admin:install": "npm --prefix admin install",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.5.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.10.0",
    "bullmq": "^5.1.0",
    "cheerio": "^1.0.0-rc.12",
    "fastify": "^4.26.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "openai": "^4.28.0",
    "pino": "^8.19.0",
    "playwright": "^1.42.0",
    "potrace": "^2.1.8",
    "sharp": "^0.35.2",
    "svgpath": "^2.6.0",
    "xmldom": "^0.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/potrace": "^2.1.5",
    "@vitest/coverage-v8": "^1.3.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}
